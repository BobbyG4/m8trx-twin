# m8trx-twin-store-ops.service — the store-day ops driver (StoreOpsLive). Started and stopped by hand: /opt/m8trx/twin-ops/store-ops.
# NOT INSTALLED ANYWHERE. Not a timer: it runs until `store-ops stop`, `hold`, or a refusal. Install: ops/INSTALL.md, "store-ops driver".
[Unit]
Description=m8trx-twin store-day ops driver (sales, moves, receipts in plan order, each store on its own local midnight)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=m8trx
WorkingDirectory=/opt/m8trx/twin
EnvironmentFile=/opt/m8trx/twin/.env
EnvironmentFile=-/opt/m8trx/twin-ops/store-ops.env
Environment=JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
Environment=M8TRX_OPS_DIR=/opt/m8trx/twin-ops
ExecStart=/opt/m8trx/twin-ops/twin-store-ops.sh
# SIGTERM to the script only; it hands the TERM to the JVM, which finishes the item in hand and stops
KillMode=mixed
TimeoutStopSec=45
# a crash restarts and resumes: the day-start state is saved, the sent-ledger skips what was accepted;
# refusals (3 = HOLD / owner file / confirmation / live loop not available, 6 = HOLD seen by the JVM) never restart
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=3 6
Nice=5

[Install]
WantedBy=multi-user.target
