[Unit]
Description=m8trx-twin daily delivery for %i (pre-opening order, receive, put-away, top-up)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=m8trx
WorkingDirectory=/opt/m8trx/twin
EnvironmentFile=/opt/m8trx/twin/.env
Environment=JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
Environment=LIVE=1 OWN=1
ExecStart=/opt/m8trx/twin/ops/daily-delivery.sh %i
RuntimeMaxSec=3h
Nice=10
