# M8TRX Twin — environment template. Copy to `.env` (gitignored) and fill in.
# NEVER commit real secrets. Service keys / HMAC secrets are provisioned out-of-band.

# ── NATS / REST smoke path (existing — TwinConfig.fromEnv) ─────────────────────
M8TRX_NATS_URL=nats://192.168.55.29:4222
M8TRX_REST_URL=http://192.168.55.28:9999
M8TRX_TENANT_ID=
M8TRX_SITE_ID=
M8TRX_SPACE_ID=

# ── M8TRX Connect simulators (ConnectConfig.fromEnv — CORE-REQ-003) ────────────
# Two surfaces, do NOT conflate (Connect API doc §2):
#   Bearer plane  (data + control) — camelCase
#   Webhook plane (inbound ingest) — snake_case
M8TRX_CONNECT_API_BASE=https://dev.m8trx.com/server/api/v2
M8TRX_CONNECT_WEBHOOK_BASE=https://dev.m8trx.com/server/v1/webhook

# The {integrationKey} path segment for POST /v1/webhook/{tenantId}/{integrationKey}.
# MVP: equals the integration's name (the P1 webhook_slug column will change this).
M8TRX_CONNECT_INTEGRATION_SLUG=

# The minted m8trx_<hex> Bearer for the data/control plane. Provisioned out-of-band by Bob
# (or minted via ApiKeyBootstrap). Plaintext shown once — store here, never in code.
M8TRX_TWIN_SERVICE_BEARER=

# Inbound webhook auth — pick ONE path per run (the AuthMode switch):
#   X-API-Key path:
M8TRX_TWIN_WEBHOOK_KEY=
#   HMAC path — signs OUR inbound pushes (= the inbound channel's endpoint_config.hmac_secret):
M8TRX_CONNECT_INBOUND_HMAC_SECRET=

# Outbound receiver — verifies M8TRX's X-M8TRX-Signature on the stocktake_result it pushes to us.
# This is a DISTINCT secret from the inbound one (do not reuse).
M8TRX_CONNECT_OUTBOUND_VERIFY_SECRET=
